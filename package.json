{
  "name": "jobowl",
  "version": "0.2.0",
  "description": "Job search on your own PC: find openings, tailor your resume truthfully, prepare applications, track what you sent.",
  "author": "Regee Casaña <regeecasana57@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/rekasa7000/jobowl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rekasa7000/jobowl.git"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "mammoth": "^1.13.0",
    "ollama": "^0.6.4",
    "openai": "^7.62.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@playwright/test": "latest",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "@types/better-sqlite3": "latest",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
